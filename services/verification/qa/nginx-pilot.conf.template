limit_req_zone $binary_remote_addr zone=malak_login_rate:1m rate=2r/s;
limit_req_zone $binary_remote_addr zone=malak_ocr_rate:1m rate=1r/s;
limit_conn_zone $binary_remote_addr zone=malak_connections:1m;
server {
 listen 8080;
 server_name _;
 server_tokens off;
 access_log off;
 error_log /dev/null crit;
 client_max_body_size 12m;
 client_body_timeout 30s;
 limit_conn malak_connections 8;
 add_header Cache-Control "no-store" always;
 add_header X-Content-Type-Options "nosniff" always;
 proxy_ssl_server_name on;
 proxy_ssl_name __MAC_TLS_HOST__;
 proxy_ssl_verify on;
 proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
 proxy_ssl_verify_depth 4;
 proxy_set_header Host __MAC_TLS_HOST__;
 proxy_set_header Connection close;
 proxy_connect_timeout 10s;
 proxy_send_timeout 40s;
 proxy_read_timeout 180s;
 location = /healthz {
  limit_except GET { deny all; }
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /internal/v1/pilot/login {
  limit_except POST { deny all; }
  limit_req zone=malak_login_rate burst=4 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /internal/v1/pilot/preview-cin {
  limit_except POST { deny all; }
  limit_req zone=malak_ocr_rate burst=3 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /internal/v1/pilot/compare-pair {
  limit_except POST { deny all; }
  limit_req zone=malak_ocr_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /api/pilot/submissions {
  limit_except GET POST { deny all; }
  limit_req zone=malak_ocr_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /api/admin/login {
  limit_except POST { deny all; }
  limit_req zone=malak_login_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /api/admin/submissions {
  limit_except GET { deny all; }
  limit_req zone=malak_ocr_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /api/public/listings {
  limit_except GET { deny all; }
  limit_req zone=malak_ocr_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /admin {
  limit_except GET { deny all; }
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /admin/ {
  limit_except GET { deny all; }
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /admin/app.js {
  limit_except GET { deny all; }
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location = /admin/style.css {
  limit_except GET { deny all; }
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location ~ ^/api/pilot/reviews/[0-9a-f-]+/photos$ {
  limit_except POST { deny all; }
  limit_req zone=malak_ocr_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location ~ ^/api/admin/evidence/[0-9a-f-]+$ {
  limit_except GET { deny all; }
  limit_req zone=malak_ocr_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location ~ ^/api/admin/submissions/[0-9a-f-]+/decision$ {
  limit_except POST { deny all; }
  limit_req zone=malak_ocr_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location ~ ^/api/public/photos/[0-9a-f-]+$ {
  limit_except GET { deny all; }
  limit_req zone=malak_ocr_rate burst=12 nodelay;
  proxy_pass https://__MAC_TLS_HOST__:10000;
 }
 location / { return 404; }
}